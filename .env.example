# Copy to .env and fill in. .env is gitignored.

# Cloud model
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# Local model (already installed)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b

# Messaging — Telegram, Discord, and Slack share one Hermes home.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_ID=

# Slack app: bot token (xoxb-), app-level token (xapp-), your member id (U...), home channel (C...).
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_ALLOWED_USERS=
SLACK_HOME_CHANNEL=

# Temporary Gmail only. Not a personal or USC account.
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_ALLOWLIST=

# Temporary Google Calendar secret iCal URL
CALENDAR_ICS_URL=

# Google Cloud. Sign in with gcloud; do not put a service-account JSON here.
GCP_PROJECT_ID=
GCP_REGION=

# Tailscale auth key for the Cloud Run container
TAILSCALE_AUTHKEY=

# Hermes API key, 16+ characters. The grader pastes this into the web chat.
# Submit it in the Brightspace comments. Leave the value blank in git.
HERMES_GATEWAY_KEY=

# Optional. Leave blank to use DuckDuckGo for web search.
BRAVE_API_KEY=
